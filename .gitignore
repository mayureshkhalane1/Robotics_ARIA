# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Large vendored archive (Valetudo reference firmware) — keep local, never commit
Valetudo-master.zip
*.zip

# Environment / secrets
.env
!.env.example

# Logs and generated outputs.
# NOTE: .gitignore is pattern-based — it CANNOT auto-keep "the latest N logs by
# time". We ignore everything in logs/ and all *.log files, then explicitly
# whitelist (with `!`) the specific run logs we want to publish. Update the
# whitelist below when you want newer logs committed. (spatial_memory.json and
# every non-listed run log stay ignored.)
logs/*
*.log
benchmark_results/
results/

# --- Run logs to publish. AUTO-MANAGED on `python -m src.ui.server` shutdown by
#     src/common/log_retention.py, which keeps only the latest N (default 5,
#     override with ARIA_LOG_KEEP). Do NOT hand-edit between the markers — it is
#     rewritten. Run manually with: python -m src.common.log_retention [N] ---
# >>> ARIA log-whitelist >>>
!logs/run_20260615_193556.log
!logs/run_20260615_181435.log
!logs/run_20260615_181354.log
!logs/run_20260615_181318.log
!logs/run_20260614_230128.log
# <<< ARIA log-whitelist <<<

# OS / editor
.DS_Store
.vscode/
.idea/

# Accidental nested clone/workspace
Robotics_ARIA/

# Webots generated/build artifacts
*.wbproj
*.wbt.bak
controllers/*/build/

# Webots cached thumbnails / previews (often dotfiles in worlds/)
*.jpg
*.jpeg
*.png

# YOLO model weights — auto-download on first use, don't commit (~22MB+)
*.pt

# Packaging artifacts
*.egg-info/
