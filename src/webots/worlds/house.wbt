#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/released/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  title "Smart Home with Furniture"
  window {
    width 1200
    height 900
  }
  coordinateSystem "NUE"
}

Viewpoint {
  orientation -0.57735 0.57735 0.57735 2.0944
  position 15 15 15
}

TexturedBackground {
  texture "noon_park_empty"
}

TexturedBackgroundLight {
  texture "noon_park_empty"
}

RectangleArena {
  floorSize 20 20
  floorTileSize 1 1
  wallHeight 2.5
}

DEF ROBOT Robot {
  translation 1 0.62 1
  rotation 0 1 0 0
  children [
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.1 0.8
        metalness 0.3
        roughness 0.4
      }
      geometry Box {
        size 0.4 1.2 0.3
      }
    }
    DEF WHEEL_FL HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.15 0.1 0.2
      }
      device [
        RotationalMotor {
          name "wheel_fl_motor"
          maxVelocity 10
          maxTorque 20
        }
        PositionSensor {
          name "wheel_fl_sensor"
        }
      ]
      endPoint Solid {
        translation 0.15 0.1 0.2
        rotation 1 0 0 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.3 0.3 0.3
              metalness 0.8
              roughness 0.2
            }
            geometry Cylinder {
              radius 0.1
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.1
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
    DEF WHEEL_FR HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.15 0.1 0.2
      }
      device [
        RotationalMotor {
          name "wheel_fr_motor"
          maxVelocity 10
          maxTorque 20
        }
        PositionSensor {
          name "wheel_fr_sensor"
        }
      ]
      endPoint Solid {
        translation -0.15 0.1 0.2
        rotation 1 0 0 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.3 0.3 0.3
              metalness 0.8
              roughness 0.2
            }
            geometry Cylinder {
              radius 0.1
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.1
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
    DEF WHEEL_BL HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.15 0.1 -0.2
      }
      device [
        RotationalMotor {
          name "wheel_bl_motor"
          maxVelocity 10
          maxTorque 20
        }
        PositionSensor {
          name "wheel_bl_sensor"
        }
      ]
      endPoint Solid {
        translation 0.15 0.1 -0.2
        rotation 1 0 0 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.3 0.3 0.3
              metalness 0.8
              roughness 0.2
            }
            geometry Cylinder {
              radius 0.1
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.1
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
    DEF WHEEL_BR HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.15 0.1 -0.2
      }
      device [
        RotationalMotor {
          name "wheel_br_motor"
          maxVelocity 10
          maxTorque 20
        }
        PositionSensor {
          name "wheel_br_sensor"
        }
      ]
      endPoint Solid {
        translation -0.15 0.1 -0.2
        rotation 1 0 0 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.3 0.3 0.3
              metalness 0.8
              roughness 0.2
            }
            geometry Cylinder {
              radius 0.1
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.1
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
    }
    DEF CAMERA Camera {
      translation 0 0.9 0
      rotation 0 0 1 0
      name "main_camera"
      width 320
      height 240
      near 0.01
      far 50
      fieldOfView 0.8
    }
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        metalness 0.4
        roughness 0.5
      }
      geometry Box {
        size 0.3 0.2 0.3
      }
    }
  ]
  boundingObject Box {
    size 0.4 1.2 0.3
  }
  physics Physics {
    density -1
    mass 5
  }
  controller "robot_controller"
}

