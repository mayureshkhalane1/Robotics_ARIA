EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info ["ARIA house-style navigation demo with Pioneer 3-DX and TCP controller"]
  title "ARIA House Demo"
  basicTimeStep 8
}
Viewpoint {
  orientation -0.48 0.35 0.8 2.1
  position 6 -9 7
}
TexturedBackground { }
TexturedBackgroundLight { }
RectangleArena {
  floorSize 12 9
  floorTileSize 1 1
  wallHeight 0.35
}
DEF PIONEER_3DX Pioneer3dx {
  translation -4 -2.7 0.0975
  rotation 0 0 1 0
  controller "tcp_controller"
  extensionSlot [
    GPS { name "gps" }
    Compass { name "compass" }
    Camera {
      name "camera"
      width 320
      height 240
      fieldOfView 1.047
      near 0.02
    }
  ]
}


