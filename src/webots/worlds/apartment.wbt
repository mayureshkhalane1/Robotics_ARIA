DEF ARIA_ROBOT Robot {
  translation 0 0.15 0
  rotation 0 0 1 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.1 0.8
        metalness 0.3
        roughness 0.4
      }
      geometry Box {
        size 0.4 1.2 0.3
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.15 0.05 0.2
      }
      device [
        RotationalMotor {
          name "wheel_fl_motor"
          maxVelocity 10
          maxTorque 20
        }
      ]
      endPoint Solid {
        translation 0.15 0.05 0.2
        rotation 1 0 0 0
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.2 0.2
            }
            geometry Cylinder {
              radius 0.1
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.1
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.5
