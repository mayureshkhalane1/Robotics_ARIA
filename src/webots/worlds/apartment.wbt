    DEF WHEEL_BR HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.15 0.05 -0.2
      }
      device [
        RotationalMotor {
          name "wheel_br_motor"
          maxVelocity 10
          maxTorque 20
        }
      ]
      endPoint DEF WHEEL_BR_SOLID Solid {
        translation -0.15 0.05 -0.2
        rotation 1 0 0 0
        name "wheel_br"
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.2 0.2
            }
            geometry Cylinder {
              radius 0.1
              height 0.05
            }
          }
        ]
        boundingObject Cylinder {
          radius 0.1
          height 0.05
        }
        physics Physics {
          density -1
          mass 0.5
        }
      }
