#VRML_SIM R2023b utf8

WorldInfo {
  title "Apartment (Pure VRML)"
  basicTimeStep 16
}

Viewpoint {
  orientation 0.377 0.910 0.173 2.42
  position 7.5 6.0 9.5
}

# Simple floor
DEF FLOOR Solid {
  translation 0 0 0
  rotation 0 1 0 0
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.8 0.8 0.8 }
      }
      geometry Box { size 12 0.1 9 }
    }
  ]
  boundingObject Transform {
    translation 0 0 0
    children [
      Box { size 12 0.1 9 }
    ]
  }
  physics Physics { mass 0 }
}

# Simple lighting
DEF OVERHEAD_LIGHT PointLight {
  location 0 3 0
  intensity 2.5
  radius 20
  attenuation 0 0 1
}

# ARIA Robot (reimplemented as pure geometry)
DEF ARIA_ROBOT Solid {
  translation -4 0 0.1
  rotation 0 0 1 0
  children [
    # Body (simple box)
    Shape {
      appearance Appearance { material Material { diffuseColor 0.4 0.4 0.4 } }
      geometry Box { size 0.5 0.2 0.7 }
    }
    # Camera (placeholder box)
    Transform {
      translation 0 0.1 0.35
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0 0 0 } }
          geometry Box { size 0.1 0.1 0.1 }
        }
      ]
    }
    # Wheels
    Transform {
      translation -0.25 0 -0.35
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } }
          geometry Cylinder { radius 0.07 height 0.05 }
        }
      ]
    }
    Transform {
      translation 0.25 0 -0.35
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } }
          geometry Cylinder { radius 0.07 height 0.05 }
        }
      ]
    }
    # Sensors placeholder (GPS/Compass)
    Transform {
      translation 0 0.12 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0 0 1 } }
          geometry Box { size 0.05 0.05 0.05 }
        }
      ]
    }
  ]
  physics Physics { mass 5 }
}

# Searchable objects
DEF CUP Solid {
  translation 2 0 2
  children [
    Shape { appearance Appearance { material Material { diffuseColor 1 0 0 } } geometry Cylinder { radius 0.05 height 0.1 } }
  ]
  boundingObject Cylinder { radius 0.05 height 0.1 }
  physics Physics { mass 0.2 }
}

DEF FOOTBALL Solid {
  translation -1 0 3
  children [
    Shape { appearance Appearance { material Material { diffuseColor 0 1 0 } } geometry Sphere { radius 0.1 } }
  ]
  boundingObject Sphere { radius 0.1 }
  physics Physics { mass 0.3 }
}

DEF BOTTLE Solid {
  translation 0 0 4
  children [
    Shape { appearance Appearance { material Material { diffuseColor 0 0 1 } } geometry Cylinder { radius 0.04 height 0.15 } }
  ]
  boundingObject Cylinder { radius 0.04 height 0.15 }
  physics Physics { mass 0.1 }
}

DEF PLANT Solid {
  translation 3 0 1
  children [
    Shape { appearance Appearance { material Material { diffuseColor 0 0.5 0 } } geometry Cylinder { radius 0.05 height 0.3 } }
  ]
  boundingObject Cylinder { radius 0.05 height 0.3 }
  physics Physics { mass 0.2 }
}

# End of file