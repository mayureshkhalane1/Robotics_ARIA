# LLM Configuration
# The VLM is OPTIONAL — the Lidar + frontier planner handles navigation.
# Set ARIA_USE_LLM=0 to skip Ollama entirely (fastest; no dependency on it).
ARIA_USE_LLM=0
LLM_PROVIDER=ollama
# Leave OLLAMA_BASE_URL unset under WSL2 — it auto-detects the Windows gateway
# (http://172.20.x.x:11434). Setting it to localhost here would break WSL2.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct-q4_K_M
OLLAMA_REASONING_MODEL=qwen3:8b
# Per-call timeout (s). Lower (e.g. 5) if you keep the LLM on but it's flaky.
OLLAMA_VISION_TIMEOUT=35
OLLAMA_VISION_NUM_PREDICT=384
OLLAMA_VISION_IMAGE_MAX_DIM=640
OLLAMA_VISION_SAMPLE_INTERVAL=1
ANTHROPIC_API_KEY=

# Perception fallback (YOLO) — only used when PERCEPTION_MODE enables it.
# yolo11m is the default stronger local detector. Use yolo11s if you want a
# little less latency and can tolerate more misses at distance. First use auto-downloads the weights.
YOLO_MODEL=yolo11m
YOLO_CONF=0.25
YOLO_IOU=0.45

# Webots Connection
# Leave WEBOTS_HOST unset under WSL2 — it auto-detects the Windows gateway.
# WEBOTS_HOST=localhost
WEBOTS_PORT=19997
# World file loaded as training map (break_room is the active world)
# WEBOTS_WORLD_FILE=src/webots/worlds/Project/worlds/break_room.wbt
WEBOTS_SIM_SPEED=0.1
WEBOTS_TIMEOUT=30

# Agent Configuration
MAX_STEPS=50
STATE_CACHE_SIZE=10
STAGNATION_THRESHOLD=5
STEP_TIMEOUT=30
AGENT_CYCLE_INTERVAL=1.2
PERCEPTION_MODE=vlm_first
