# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:3b
OLLAMA_VISION_TIMEOUT=35
OLLAMA_VISION_NUM_PREDICT=160
OLLAMA_VISION_IMAGE_MAX_DIM=640
OLLAMA_VISION_SAMPLE_INTERVAL=10
