# LLM Configuration
# The LLM is OPTIONAL — YOLO detects targets, the Lidar handles navigation.
# Set ARIA_USE_LLM=0 to skip Ollama entirely (fastest; no dependency on it).
ARIA_USE_LLM=0
LLM_PROVIDER=ollama
# Leave OLLAMA_BASE_URL unset under WSL2 — it auto-detects the Windows gateway
# (http://172.20.x.x:11434). Setting it to localhost here would break WSL2.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava-phi3:latest
OLLAMA_REASONING_MODEL=llava-phi3:latest
# Per-call timeout (s). Lower (e.g. 5) if you keep the LLM on but it's flaky.
OLLAMA_VISION_TIMEOUT=35
OLLAMA_VISION_NUM_PREDICT=160
OLLAMA_VISION_IMAGE_MAX_DIM=640
OLLAMA_VISION_SAMPLE_INTERVAL=10
ANTHROPIC_API_KEY=

# Perception (YOLO) — this is the actual target detector, runs every step.
# yolov8s detects small/distant objects (like a dog across the room) far better
# than yolov8n. First use auto-downloads the weights (~22MB). Use yolov8n to
# avoid the download, or yolov8m for even better accuracy (slower).
YOLO_MODEL=yolov8s
YOLO_CONF=0.35
YOLO_IOU=0.45

# Webots Connection
# Leave WEBOTS_HOST unset under WSL2 — it auto-detects the Windows gateway.
# WEBOTS_HOST=localhost
WEBOTS_PORT=19997
# World file loaded as training map (break_room is the active world)
# WEBOTS_WORLD_FILE=src/webots/worlds/Project/worlds/break_room.wbt
WEBOTS_SIM_SPEED=0.1
WEBOTS_TIMEOUT=30

# Agent Configuration
MAX_STEPS=50
STATE_CACHE_SIZE=10
STAGNATION_THRESHOLD=5
STEP_TIMEOUT=30
