# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_VISION_TIMEOUT=25
OLLAMA_VISION_NUM_PREDICT=96
OLLAMA_VISION_IMAGE_MAX_DIM=384
OLLAMA_VISION_SAMPLE_INTERVAL=10
